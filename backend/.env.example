# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4100

# Postgres connection string. When using docker-compose, this matches the
# "postgres" service defined in docker-compose.yml at the repo root (mapped
# to host port 5435 to avoid clashing with any Postgres already using 5432/
# 5433/5434 on your machine - change both if that's not an issue for you).
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5435/dashboard?schema=public"

# Comma-separated list of allowed frontend origins (for CORS + cookie scoping).
CORS_ORIGIN="http://localhost:5180"

# Generate strong random secrets, e.g. `openssl rand -hex 64`. Must differ
# from each other so a leaked access token can't be replayed as a refresh token.
ACCESS_TOKEN_SECRET="replace-with-a-long-random-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-secret"

# Access tokens are short-lived and live in memory on the client.
# Refresh tokens are long-lived and live only in an HttpOnly cookie.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_COOKIE_NAME="refresh_token"

# Cron expression for the overdue-task sweep (default: every 5 minutes).
OVERDUE_CRON_SCHEDULE="*/5 * * * *"
